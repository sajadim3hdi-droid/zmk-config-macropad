#include <dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zephyr,display = &ssd1306;
    };

    // 3 encoder push-buttons as direct-GPIO keys
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios
            = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW1 = D6
            , <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW2 = D2
            , <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // SW3 = D7
            ;
    };

    // Encoder 1: A=D3, B=D10
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    // Encoder 2: A=D0, B=D1
    middle_encoder: encoder_middle {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    // Encoder 3: A=D9, B=D8
    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &middle_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };
};

// OLED on the XIAO's built-in I2C bus (D4=SDA, D5=SCL)
&xiao_i2c {
    status = "okay";
    clock-frequency = <100000>;

    ssd1306: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;      // change to <32> if your OLED is 128x32
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};